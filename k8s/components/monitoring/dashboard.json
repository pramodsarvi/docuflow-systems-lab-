{
 "uid": "docuflow",
 "title": "docuflow",
 "tags": [
  "docuflow",
  "keda",
  "vllm"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "graphTooltip": 1,
 "templating": {
  "list": [
   {
    "name": "datasource",
    "type": "datasource",
    "query": "prometheus",
    "label": "Data source"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "Overview",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 1
  },
  {
   "type": "stat",
   "title": "Pages indexed",
   "description": "Pages searchable now (all datasets)",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(max by (dataset) (docuflow_documents{status=\"indexed\"}))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 2
  },
  {
   "type": "stat",
   "title": "Pages waiting to be read",
   "description": "Fetched pages not yet indexed",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(max by (dataset, status) (docuflow_documents{status!=\"indexed\"}))",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 3
  },
  {
   "type": "stat",
   "title": "Ingest rate",
   "description": "Pages indexed per minute (10 min average)",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(rate(docuflow_worker_jobs_total{stage=\"embed\",result=\"ok\"}[10m])) * 60",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "suffix: pages/min",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 4
  },
  {
   "type": "stat",
   "title": "ETA for the backlog",
   "description": "Pages waiting / current ingest rate",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "(sum(max by (dataset, status) (docuflow_documents{status!=\"indexed\"}))) / (sum(rate(docuflow_worker_jobs_total{stage=\"embed\",result=\"ok\"}[10m])) * 60)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "m",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 5
  },
  {
   "type": "stat",
   "title": "Dead jobs",
   "description": "Jobs that used all retries: GET /jobs?status=dead",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(max by (lane) (docuflow_jobs{status=\"dead\"})) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "red",
        "value": 1
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 6
  },
  {
   "type": "stat",
   "title": "Fallback pages",
   "description": "Indexed from dataset text, not a vision read: POST /workloads/reread-fallbacks",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(max by (dataset) (docuflow_fallback_pages)) or vector(0)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 1
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 7
  },
  {
   "type": "stat",
   "title": "Queries",
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max(docuflow_queries_paused)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": [
      {
       "type": "value",
       "options": {
        "0": {
         "text": "open",
         "color": "green"
        },
        "1": {
         "text": "paused (ingest mode)",
         "color": "orange"
        }
       }
      }
     ]
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 8
  },
  {
   "type": "stat",
   "title": "Agent model on",
   "description": "gpu = vLLM model-llm, mac = Ollama via tunnel",
   "gridPos": {
    "x": 4,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max by (agent_backend) (docuflow_info)",
     "legendFormat": "{{agent_backend}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "none",
    "graphMode": "area",
    "textMode": "name",
    "justifyMode": "center"
   },
   "id": 9
  },
  {
   "type": "stat",
   "title": "Query p95 (5 min)",
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max(docuflow_query_latency_seconds{quantile=\"0.95\"})",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 15
       },
       {
        "color": "red",
        "value": 30
       }
      ]
     },
     "mappings": [],
     "decimals": 1
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 10
  },
  {
   "type": "stat",
   "title": "Queries in flight",
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max(docuflow_queries_in_flight)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 11
  },
  {
   "type": "stat",
   "title": "GPU utilisation",
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "avg(DCGM_FI_DEV_GPU_UTIL)",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     },
     "mappings": []
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 12
  },
  {
   "type": "stat",
   "title": "GPU memory used",
   "description": "",
   "gridPos": {
    "x": 20,
    "y": 5,
    "w": 4,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum(DCGM_FI_DEV_FB_USED) / (sum(DCGM_FI_DEV_FB_USED) + sum(DCGM_FI_DEV_FB_FREE)) * 100",
     "legendFormat": "",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       },
       {
        "color": "orange",
        "value": 90
       },
       {
        "color": "red",
        "value": 97
       }
      ]
     },
     "mappings": [],
     "decimals": 0
    },
    "overrides": []
   },
   "options": {
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "colorMode": "background",
    "graphMode": "area",
    "textMode": "value",
    "justifyMode": "center"
   },
   "id": 13
  },
  {
   "type": "row",
   "title": "Ingest pipeline",
   "collapsed": false,
   "gridPos": {
    "x": 0,
    "y": 9,
    "w": 24,
    "h": 1
   },
   "panels": [],
   "id": 14
  },
  {
   "type": "bargauge",
   "title": "Progress per dataset (indexed / fetched)",
   "description": "Share of each dataset's fetched pages that are searchable",
   "gridPos": {
    "x": 0,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max by (dataset) (docuflow_documents{status=\"indexed\"}) / sum by (dataset) (max by (dataset, status) (docuflow_documents)) * 100",
     "legendFormat": "{{dataset}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "blue",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "options": {
    "displayMode": "gradient",
    "orientation": "horizontal",
    "showUnfilled": true,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "fields": ""
    },
    "namePlacement": "left"
   },
   "id": 15
  },
  {
   "type": "timeseries",
   "title": "Pages indexed per minute, by dataset",
   "description": "10 min derivative of indexed pages",
   "gridPos": {
    "x": 8,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max by (dataset) (deriv(docuflow_documents{status=\"indexed\"}[10m])) * 60 > 0",
     "legendFormat": "{{dataset}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 16
  },
  {
   "type": "timeseries",
   "title": "Vision read time per page, by dataset",
   "description": "Mean seconds per page over 15 min; dense scans take ~10x a handwriting line",
   "gridPos": {
    "x": 16,
    "y": 10,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "max by (dataset) (docuflow_read_seconds_avg)",
     "legendFormat": "{{dataset}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 17
  },
  {
   "type": "timeseries",
   "title": "RabbitMQ work tokens (KEDA input)",
   "description": "Lane queues drive worker scaling; .delay queues hold retry/outage backoffs",
   "gridPos": {
    "x": 0,
    "y": 18,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum by (queue) (rabbitmq_queue_messages_ready{queue=~\"docuflow.*\"})",
     "legendFormat": "{{queue}} ready",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    },
    {
     "expr": "sum by (queue) (rabbitmq_queue_messages_unacked{queue=~\"docuflow.*\"})",
     "legendFormat": "{{queue}} unacked",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "B"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "none"
      }
     }
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "table",
     "placement": "right",
     "calcs": [
      "lastNotNull",
      "max"
     ]
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "id": 18
  },
  {
   "type": "timeseries",
   "title": "Job outcomes per minute",
   "description": "ok, retry (page problem), deferred (model server unavailable), dead",
   "gridPos": {
    "x": 8,
    "y": 18,
    "w": 8,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "${datasource}"
   },
   "targets": [
    {
     "expr": "sum by (result) (rate(docuflow_worker_jobs_total[2m])) * 60",
     "legendFormat": "{{result}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${datasource}"
     },
     "refId": "A"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "fillOpacity": 12,
      "lineWidth": 2,
      "showPoints": "never",
      "stacking": {
       "mode": "normal"
      }
     }
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "ok"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "green"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "retry"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "orange"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "deferred"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
